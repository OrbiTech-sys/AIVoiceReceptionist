# Settings for the whole project. The FastAPI backend, the Next.js frontend and docker compose all read
# the .env file in this folder (the repository root), so this is the only settings file you need.
#
#   cp .env.example .env      then change what you need. Never commit .env.
#
# A value left blank uses the built-in default. Restart `npm run dev` (or `docker compose up -d`) after a change.

# ---------------------------------------------------------------------------------------------------------------
# Backend (FastAPI). Every backend setting starts with VR_.
# ---------------------------------------------------------------------------------------------------------------

# development | production   (production refuses to start without VR_SECRET_KEY)
VR_ENV=development

# Database. Blank = a SQLite file at backend/data/voicerep.db, which is all local development needs.
# PostgreSQL instead: postgresql+psycopg://voicerep:YOUR_PASSWORD@localhost:5432/voicerep
# docker compose ignores this line: it always connects the api to its own PostgreSQL container (see DB_PASSWORD).
# Supabase: use the "Session pooler" string (Project > Connect), written like
# postgresql+psycopg://postgres.PROJECTREF:URL-ENCODED-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# and add VR_DB_POOL_SIZE=5 and VR_DB_MAX_OVERFLOW=5 (see "Using Supabase" in the README).
VR_DATABASE_URL=

# Master key that encrypts stored secrets (SIP passwords and so on). Blank in development = a key generated once
# in backend/data/.secret_key. Production must set a long random value and never change it afterwards, or the
# stored secrets can't be read any more. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
VR_SECRET_KEY=

# Browser addresses allowed to sign in and to open the voice WebSocket (comma-separated, exact match),
# and the address people use to reach the app.
VR_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VR_PUBLIC_APP_URL=http://localhost:3000
# true when the site is served over HTTPS (production)
VR_COOKIE_SECURE=false

# Speech recognition model: tiny.en | base.en | small.en | parakeet-tdt-0.6b-v2 (most accurate, ~1.5 GB more RAM)
VR_ASR_MODEL=base.en
# true = download Whisper + Kokoro (~0.5 GB) at start-up when they're missing.
# Blank = off for `npm run dev`, on for docker compose.
# Voice: kokoro (more natural, needs a fast CPU) | piper (plainer, quick even on a laptop)
VR_TTS_ENGINE=kokoro
VR_AUTO_INSTALL_MODELS=

# Hosted services (all optional; each is used only when its key is set, and each falls back to the local models).
# Callers' audio goes to Deepgram, the words of sentences the rules couldn't understand go to Groq, and the
# receptionist's replies go to Fish Audio: say so in your privacy policy, and check what your clients' rules require.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
FISH_AUDIO_API_KEY=
# VR_LOCAL_FALLBACK=false   # hosted services only: if one fails, the call fails instead of using local models
# VR_ASR_PROVIDER=local   # keep hearing on this machine even when a Deepgram key is set
# VR_AGENT_MODE=off   # turn the LangGraph agent off (it is on whenever GROQ_API_KEY is set)
# VR_LLM_PROVIDER=local   # never use Groq, even when its key is set
# VR_GROQ_MODEL=qwen/qwen3.8-27b
# VR_LLM_CALLS_PER_CALL=6   # most LLM questions in one conversation (the cost cap)
# VR_FISH_MONTHLY_CHARS=9000   # with VR_TTS_ENGINE=fish: above this the local voice speaks

# Optional local LLM served by llama.cpp's llama-server, e.g. http://127.0.0.1:8081 (docker: http://llm:8081).
# Blank = off; calls work without it.
VR_LLM_URL=

# Optional e-mail reminders over SMTP. Blank host = e-mail off.
VR_SMTP_HOST=
VR_SMTP_PORT=587
VR_SMTP_USERNAME=
VR_SMTP_PASSWORD=
VR_SMTP_FROM=
VR_SMTP_STARTTLS=true

# Contact address sent with Web Push notifications (VAPID "sub" claim)
VR_VAPID_CONTACT=mailto:admin@example.com

# Rarely changed (defaults shown):
# VR_SESSION_DAYS=14
# VR_RUN_WORKERS=true
# VR_WORKER_INTERVAL_SECONDS=10
# VR_ASR_THREADS=0
# VR_TTS_THREADS=4
# VR_LLM_TIMEOUT_SECONDS=4
# VR_AUDIOSOCKET_ENABLED=true
# VR_AUDIOSOCKET_HOST=0.0.0.0
# VR_AUDIOSOCKET_PORT=9092
# VR_DATA_DIR=backend/data
# VR_MODELS_DIR=backend/data/models

# ---------------------------------------------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------------------------------------------

# Where Next.js forwards /api requests. docker compose sets its own value (http://api:8000).
BACKEND_URL=http://127.0.0.1:8000
# WebSocket address the browser uses for the voice test call, e.g. wss://voice.example.com.
# Blank = worked out from the page address. Baked in when the frontend is built (`next build`).
NEXT_PUBLIC_VOICE_WS_ORIGIN=

# ---------------------------------------------------------------------------------------------------------------
# docker compose only
# ---------------------------------------------------------------------------------------------------------------

# Password of the PostgreSQL container. Blank = change-me-locally, fine for local testing only.
DB_PASSWORD=
# Optional extra services to keep running: llm (see README "Optional LLM"), phone (Asterisk)
# COMPOSE_PROFILES=llm
